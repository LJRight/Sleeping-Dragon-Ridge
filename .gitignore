/NetmarbleNeo/*.csproj
/NetmarbleNeo/*.sln
/NetmarbleNeo/*.slnx
/NetmarbleNeo/mono_crash.*
.DS_Store

# 배포 산출물. Build/ServerRoot의 시작 스크립트와 로그인 백엔드는 추적한다.
/Build/android/
/Build/ios/
/Build/releases/
/Build/ServerRoot/GameServer/
/Build/ServerRoot/ServerLogs/
/ServerBuild/
/iOSClientBuild/
/ServerLogs/
/Backups/
/outputs/**/*.xlsx.inspect.ndjson

# 개발 DB, 서버 실행 환경과 로컬 서명 키
/.local-reviews/
/localServer/data/
/Build/ServerRoot/localServer/data/
__pycache__/
*.pyc
.env
*.keystore
*.jks
*.p12
*.mobileprovision

# Unity 밖의 제작용 미디어. 제작 스크립트와 설명은 추적한다.
